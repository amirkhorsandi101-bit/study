+ * برای افزودن بخش یا صفحهٔ جدید فقط همین فایل و فایل view مربوطه را ویرایش کنید.
+ */
+
+export type ViewId = 'home' | 'study' | 'diagnose' | 'progress';
+
+export interface SectionMeta {
+  id: string;
+  label: string;
+}
+
+export interface ViewMeta {
+  id: ViewId;
+  /** برچسب کوتاه در منو */
+  label: string;
+  /** عنوان صفحه */
+  title: string;
+  description: string;
